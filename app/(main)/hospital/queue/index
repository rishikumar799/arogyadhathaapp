  callNextSection: { paddingHorizontal: 24, marginBottom: 40 },
  callNextButton: { flexDirection: "row", alignItems: "center", justifyContent: "center", backgroundColor: COLORS.primary, paddingVertical: 16, borderRadius: 12, gap: 8 },
  callNextButtonText: { fontSize: 16, color: "#FFFFFF", fontWeight: "600" },
});