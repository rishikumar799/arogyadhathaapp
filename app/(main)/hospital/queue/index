import { ThemedText } from "@/components/themed-text";
import { Ionicons } from "@expo/vector-icons";
import { LinearGradient } from "expo-linear-gradient";
import React, { useState } from "react";
import {
  ScrollView,
  StyleSheet,
  TouchableOpacity,
  View,
  TextInput,
  FlatList,
  Alert
} from "react-native";

const COLORS = {
  primary: "#10B981",
  secondary: "#3B82F6",
  accent: "#8B5CF6",
  warning: "#F59E0B",
  danger: "#EF4444",
  success: "#10B981",
  text: "#0F172A",
  textLight: "#334155",
  muted: "#64748B",
  border: "#E2E8F0",
  soft: "#ECFDF5",
  bg: "#FFFFFF",
};

export default function QueuePage() {
  const [queue, setQueue] = useState([
    { id: "1", name: "John Carter", doctor: "Dr. Smith", waitTime: "15 min", priority: "High", status: "Waiting", condition: "Cardiac Checkup", room: "304" },
    { id: "2", name: "Emily Stone", doctor: "Dr. Johnson", waitTime: "25 min", priority: "Normal", status: "Waiting", condition: "Dental Cleaning", room: "Dental Wing" },
    { id: "3", name: "Michael Ross", doctor: "Dr. Wilson", waitTime: "5 min", priority: "Critical", status: "Ready", condition: "Chest Pain", room: "Emergency" },
    { id: "4", name: "Sarah Johnson", doctor: "Dr. Brown", waitTime: "40 min", priority: "Normal", status: "Waiting", condition: "Knee Pain", room: "112" },
    { id: "5", name: "David Brown", doctor: "Dr. Miller", waitTime: "30 min", priority: "High", status: "In Progress", condition: "Fever", room: "101" },
  ]);

  const handleCallNext = (patient) => {
    Alert.alert("Call Patient", `Call ${patient.name} to ${patient.room}?`, [
      { text: "Cancel", style: "cancel" },
      { text: "Call Now", onPress: () => {
        // Update queue status
        setQueue(prev => prev.map(p => 
          p.id === patient.id ? { ...p, status: "Called" } : p
        ));
        Alert.alert("Called", `${patient.name} has been called to ${patient.room}`);
      }}
    ]);
  };

  const handleMarkComplete = (patient) => {
    Alert.alert("Mark Complete", `Mark ${patient.name}'s visit as complete?`, [
      { text: "Cancel", style: "cancel" },
      { text: "Complete", onPress: () => {
        // Remove from queue
        setQueue(prev => prev.filter(p => p.id !== patient.id));
        Alert.alert("Completed", `${patient.name}'s visit marked complete`);
      }}
    ]);
  };

  const handlePriorityChange = (patient, newPriority) => {
    setQueue(prev => prev.map(p => 
      p.id === patient.id ? { ...p, priority: newPriority } : p
    ));
  };

  const renderQueueItem = ({ item }) => (
    <View style={styles.queueCard}>
      <View style={styles.queueHeader}>
        <View style={styles.patientInfo}>
          <View style={[
            styles.avatar,
            { 
              backgroundColor: 
                item.priority === 'Critical' ? COLORS.danger + '20' : 
                item.priority === 'High' ? COLORS.warning + '20' : COLORS.primary + '20' 
            }
          ]}>
            <ThemedText style={[
              styles.avatarText,
              { 
                color: 
                  item.priority === 'Critical' ? COLORS.danger : 
                  item.priority === 'High' ? COLORS.warning : COLORS.primary 
              }
            ]}>
              {item.name.split(' ').map(n => n[0]).join('')}
            </ThemedText>
          </View>
          <View style={styles.patientDetails}>
            <ThemedText style={styles.patientName}>{item.name}</ThemedText>
            <View style={styles.detailsRow}>
              <ThemedText style={styles.conditionText}>{item.condition}</ThemedText>
              <View style={styles.doctorInfo}>
                <Ionicons name="medkit" size={12} color={COLORS.muted} />
                <ThemedText style={styles.doctorName}>{item.doctor}</ThemedText>
              </View>
            </View>
          </View>
        </View>
        
        <View style={styles.queueStats}>
          <View style={styles.waitTime}>
            <Ionicons name="time" size={14} color={COLORS.muted} />
            <ThemedText style={styles.waitTimeText}>{item.waitTime}</ThemedText>
          </View>
          <ThemedText style={styles.roomText}>Room {item.room}</ThemedText>
        </View>
      </View>
      
      <View style={styles.queueFooter}>
        <View style={styles.statusSection}>
          <View style={[
            styles.statusBadge,
            { 
              backgroundColor: 
                item.status === 'Ready' ? '#D1FAE5' : 
                item.status === 'In Progress' ? '#E0F2FE' : 
                item.status === 'Called' ? '#FEF3C7' : '#F3F4F6' 
            }
          ]}>
            <View style={[
              styles.statusDot,
              { 
                backgroundColor: 
                  item.status === 'Ready' ? COLORS.success : 
                  item.status === 'In Progress' ? COLORS.secondary : 
                  item.status === 'Called' ? COLORS.warning : COLORS.muted 
              }
            ]} />
            <ThemedText style={[
              styles.statusText,
              { 
                color: 
                  item.status === 'Ready' ? COLORS.success : 
                  item.status === 'In Progress' ? COLORS.secondary : 
                  item.status === 'Called' ? COLORS.warning : COLORS.muted 
              }
            ]}>
              {item.status}
            </ThemedText>
          </View>
          
          <TouchableOpacity 
            style={[
              styles.priorityButton,
              { 
                backgroundColor: 
                  item.priority === 'Critical' ? '#FEE2E2' : 
                  item.priority === 'High' ? '#FEF3C7' : COLORS.soft 
              }
            ]}
            onPress={() => {
              const priorities = ['Normal', 'High', 'Critical'];
              const currentIndex = priorities.indexOf(item.priority);
              const nextPriority = priorities[(currentIndex + 1) % priorities.length];
              handlePriorityChange(item, nextPriority);
            }}
          >
            <ThemedText style={[
              styles.priorityText,
              { 
                color: 
                  item.priority === 'Critical' ? COLORS.danger : 
                  item.priority === 'High' ? COLORS.warning : COLORS.primary 
              }
            ]}>
              {item.priority} Priority
            </ThemedText>
          </TouchableOpacity>
        </View>
        
        <View style={styles.actionButtons}>
          {item.status === 'Ready' && (
            <TouchableOpacity 
              style={styles.callButton}
              onPress={() => handleCallNext(item)}
            >
              <Ionicons name="megaphone" size={14} color="#FFFFFF" />
              <ThemedText style={styles.callButtonText}>Call</ThemedText>
            </TouchableOpacity>
          )}
          
          {item.status === 'In Progress' && (
            <TouchableOpacity 
              style={styles.completeButton}
              onPress={() => handleMarkComplete(item)}
            >
              <Ionicons name="checkmark-circle" size={14} color={COLORS.success} />
              <ThemedText style={[styles.completeButtonText, { color: COLORS.success }]}>Complete</ThemedText>
            </TouchableOpacity>
          )}
          
          <TouchableOpacity style={styles.viewButton}>
            <Ionicons name="eye" size={14} color={COLORS.primary} />
            <ThemedText style={[styles.viewButtonText, { color: COLORS.primary }]}>View</ThemedText>
          </TouchableOpacity>
        </View>
      </View>
    </View>
  );

  return (
    <ScrollView style={styles.page} showsVerticalScrollIndicator={false}>
      {/* HEADER */}
      <LinearGradient colors={[COLORS.primary, COLORS.primaryLight]} style={styles.header}>
        <View style={styles.headerContent}>
          <View>
            <ThemedText style={styles.headerTitle}>Waiting Queue</ThemedText>
            <ThemedText style={styles.headerSubtitle}>Manage patient waiting list and priorities</ThemedText>
          </View>
          <View style={styles.queueStatsHeader}>
            <View style={styles.queueStatBadge}>
              <ThemedText style={styles.queueStatValue}>{queue.length}</ThemedText>
              <ThemedText style={styles.queueStatLabel}>In Queue</ThemedText>
            </View>
          </View>
        </View>
      </LinearGradient>

      {/* QUEUE STATS */}
      <View style={styles.statsContainer}>
        <View style={styles.statCard}>
          <ThemedText style={[styles.statValue, { color: COLORS.danger }]}>
            {queue.filter(p => p.priority === 'Critical').length}
          </ThemedText>
          <ThemedText style={styles.statLabel}>Critical</ThemedText>
        </View>
        <View style={styles.statCard}>
          <ThemedText style={[styles.statValue, { color: COLORS.warning }]}>
            {queue.filter(p => p.priority === 'High').length}
          </ThemedText>
          <ThemedText style={styles.statLabel}>High Priority</ThemedText>
        </View>
        <View style={styles.statCard}>
          <ThemedText style={styles.statValue}>
            {queue.filter(p => p.status === 'Ready').length}
          </ThemedText>
          <ThemedText style={styles.statLabel}>Ready</ThemedText>
        </View>
        <View style={styles.statCard}>
          <ThemedText style={styles.statValue}>
            {Math.floor(queue.reduce((sum, p) => {
              const time = parseInt(p.waitTime);
              return sum + (isNaN(time) ? 0 : time);
            }, 0) / queue.length)} min
          </ThemedText>
          <ThemedText style={styles.statLabel}>Avg Wait Time</ThemedText>
        </View>
      </View>

      {/* SEARCH */}
      <View style={styles.searchSection}>
        <View style={styles.searchContainer}>
          <Ionicons name="search" size={20} color={COLORS.muted} />
          <TextInput
            style={styles.searchInput}
            placeholder="Search in queue..."
            placeholderTextColor={COLORS.muted}
          />
        </View>
        <TouchableOpacity style={styles.filterButton}>
          <Ionicons name="filter" size={20} color={COLORS.primary} />
          <ThemedText style={styles.filterText}>Filter</ThemedText>
        </TouchableOpacity>
      </View>

      {/* QUEUE LIST */}
      <View style={styles.contentSection}>
        <FlatList
          data={queue.sort((a, b) => {
            const priorityOrder = { 'Critical': 0, 'High': 1, 'Normal': 2 };
            return priorityOrder[a.priority] - priorityOrder[b.priority];
          })}
          renderItem={renderQueueItem}
          keyExtractor={item => item.id}
          scrollEnabled={false}
        />
      </View>

      {/* CALL NEXT BUTTON */}
      <View style={styles.callNextSection}>
        <TouchableOpacity 
          style={styles.callNextButton}
          onPress={() => {
            const nextPatient = queue.find(p => p.status === 'Ready');
            if (nextPatient) {
              handleCallNext(nextPatient);
            } else {
              Alert.alert("No Patients Ready", "No patients are marked as ready to be called.");
            }
          }}
        >
          <Ionicons name="megaphone" size={20} color="#FFFFFF" />
          <ThemedText style={styles.callNextButtonText}>Call Next Patient</ThemedText>
        </TouchableOpacity>
      </View>
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  page: { flex: 1, backgroundColor: COLORS.bg },
  header: { paddingHorizontal: 24, paddingTop: 60, paddingBottom: 30, borderBottomLeftRadius: 24, borderBottomRightRadius: 24 },
  headerContent: { flexDirection: "row", justifyContent: "space-between", alignItems: "center" },
  headerTitle: { fontSize: 32, color: "#FFFFFF", fontWeight: "800", marginBottom: 4 },
  headerSubtitle: { fontSize: 16, color: "rgba(255,255,255,0.9)" },
  queueStatsHeader: { alignItems: "flex-end" },
  queueStatBadge: { backgroundColor: "rgba(255,255,255,0.2)", paddingHorizontal: 16, paddingVertical: 10, borderRadius: 12, alignItems: "center" },
  queueStatValue: { fontSize: 24, color: "#FFFFFF", fontWeight: "800", marginBottom: 2 },
  queueStatLabel: { fontSize: 12, color: "rgba(255,255,255,0.8)", fontWeight: "600" },
  statsContainer: { flexDirection: "row", paddingHorizontal: 24, marginVertical: 20, gap: 8 },
  statCard: { flex: 1, backgroundColor: COLORS.soft, padding: 12, borderRadius: 12, alignItems: "center" },
  statValue: { fontSize: 22, fontWeight: "800", marginBottom: 2 },
