  doctorInfo: { flexDirection: "row", alignItems: "center", gap: 4 },
  doctorName: { fontSize: 12, color: COLORS.muted },
  queueStats: { alignItems: "flex-end" },
  waitTime: { flexDirection: "row", alignItems: "center", gap: 4, marginBottom: 4 },
