  searchSection: { paddingHorizontal: 24, marginBottom: 20, flexDirection: "row", gap: 12 },
  searchContainer: { flex: 1, flexDirection: "row", alignItems: "center", backgroundColor: COLORS.soft, paddingHorizontal: 16, paddingVertical: 12, borderRadius: 12 },
  searchInput: { flex: 1, marginLeft: 10, fontSize: 16, color: COLORS.text },
  filterButton: { flexDirection: "row", alignItems: "center", backgroundColor: COLORS.soft, paddingHorizontal: 16, paddingVertical: 12, borderRadius: 12, gap: 6 },
  filterText: { fontSize: 14, color: COLORS.primary, fontWeight: "600" },
  contentSection: { paddingHorizontal: 24, paddingBottom: 20 },
  queueCard: { backgroundColor: COLORS.bg, borderRadius: 16, padding: 16, marginBottom: 12, borderWidth: 1, borderColor: COLORS.border },
  queueHeader: { flexDirection: "row", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 16 },
  patientInfo: { flexDirection: "row", alignItems: "center", flex: 1 },
  avatar: { width: 44, height: 44, borderRadius: 12, alignItems: "center", justifyContent: "center", marginRight: 12 },
  avatarText: { fontSize: 16, fontWeight: "800" },
  patientDetails: { flex: 1 },
  patientName: { fontSize: 16, fontWeight: "700", color: COLORS.text, marginBottom: 4 },
